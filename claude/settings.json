					{
						"type": "command",
						"command": "python3 ~/.claude/hooks/chrome-mcp-permissions.py"
					}
				]
			},
			{
				"matcher": "mcp__local-wp__wp_cli",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ~/.claude/hooks/command-allowlist-permissions.py"
					}
				]
			},
			{
