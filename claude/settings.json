            "if": "Bash(cp *)"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/worktree-command-permissions.py",
            "if": "Bash(command cp *)"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/worktree-command-permissions.py",
            "if": "Bash(rm *)"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/worktree-command-permissions.py",
            "if": "Bash(command rm *)"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/worktree-command-permissions.py",
