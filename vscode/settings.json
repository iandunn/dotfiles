	"terminal.integrated.profiles": {
		"bash": {
			"path": "/opt/homebrew/bin/bash",
			"args": ["-l"]
		}
	},
	"terminal.integrated.defaultProfile.osx": "bash",
	"terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font Mono",

	// The default `${process}` shows the Claude binary's filename, which is its version number,
	// because it's installed at `~/.local/share/claude/versions/<version>`. `${sequence}` shows the
	// title the running program set instead, which is Claude's summary of the conversation.
	// `console_title_template` in `bash/iandunn.omp.yml` keeps this populated outside of Claude.
	"terminal.integrated.tabs.title": "${sequence}",

	// Sticky scroll pins the entire multi-line `bash/iandunn.omp.yml` prompt to the top of the pane
	// while output scrolls beneath it, costing up to 4 rows in an already short split. It slices from
	// the prompt's first row downward, so lowering `maxLineCount` keeps the path and drops the
	// command, which is backwards. Not worth it when each split's command is already known.
	"terminal.integrated.stickyScroll.enabled": false,
	"editor.fontFamily": "CaskaydiaCove Nerd Font",
	// change ^ to something better, but below isn't working
	// it needs to be font nerd so it has the ligatures for dotfiles/iandunn.omp.yml
